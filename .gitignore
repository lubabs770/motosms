# Device-specific and secret. Never commit: these carry the phone's adb serial,
# LAN/tailnet addresses and the allow-listed phone number.
env
allow

# Runtime artefacts, if anything ever lands in the working dir
*.log
*.jpg
*.png

# Local helpers and byproducts that are not part of this project
__pycache__/
mail-notify

# Machine-specific MCP server list for the SMS handler (absolute local paths)
mcp.json

# Copy to ./env and fill in. chmod 600 — this file identifies the device.
# Everything here is device-specific and deliberately kept out of git.

# Termux ssh endpoint on the relay phone
PHONE_USER=u0_aNNN
PHONE_PORT=8022
PHONE_TAILNET=100.x.y.z
PHONE_LAN=192.168.1.x

# adb serial for the USB transport (preferred when the cable is in)
ADB_SERIAL=XXXXXXXXXX
ADB_LOCAL_PORT=18022

# Inbound poll cadence (seconds): snaps to MIN after a message, decays to MAX
POLL_MIN=5
POLL_MAX=60
POLL_DECAY=16

# Outbound text ceiling. This carrier cannot send UCS-2 at all and fails GSM-7
# above roughly 4076 chars, so stay under it.
MAXCHARS=3800

# The motomms app's loopback port on the phone, and the carrier's MMS size cap
MMS_PORT=8099
MMS_MAX_BYTES=1000000
